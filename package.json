    "./convert": "./src/convert.js",
    "./dsh": "./src/dsh.js",
    "./domains": "./src/domains.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.10.0"
  },
